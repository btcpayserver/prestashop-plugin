{
  "name": "btcpay/prestashop-plugin",
  "description": "BTCPay Server payment plugin for PrestaShop",
  "license": "MIT",
  "type": "prestashop-module",
  "keywords": [
    "BTCPay",
    "BTCPay Server",
    "bitcoin",
    "crypto",
    "ecommerce",
    "module",
    "payment",
    "plugin",
    "prestashop"
  ],
  "homepage": "https://github.com/btcpayserver/prestashop-plugin",
  "support": {
    "issues": "https://github.com/btcpayserver/prestashop-plugin/issues",
    "source": "https://github.com/btcpayserver/prestashop-plugin"
  },
  "require": {
    "php": ">=8.4",
    "ext-bcmath": "*",
    "ext-ctype": "*",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-hash": "*",
    "ext-json": "*",
    "composer/installers": "^2.2.0"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0.0",
    "ergebnis/composer-normalize": "^2.43.0",
    "ext-dom": "*",
    "ext-filter": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "ext-simplexml": "*",
    "ext-tokenizer": "*",
    "ext-xmlwriter": "*",
    "ezyang/htmlpurifier": "dev-master as 4.17.0",
    "friendsofphp/php-cs-fixer": "^3.64",
    "lcobucci/jwt": "^5.0.0",
    "php-parallel-lint/php-console-highlighter": "^1.0",
    "php-parallel-lint/php-parallel-lint": "^1.4.0",
    "phpoffice/phpspreadsheet": "^1.30.7",
    "prestashop/autoindex": "^2.1",
    "prestashop/php-dev-tools": "^5",
    "prestashop/prestashop": "^9.2",
    "roave/security-advisories": "dev-latest",
    "slevomat/coding-standard": "^8.15.0",
    "squizlabs/php_codesniffer": "^3.10.2"
  },
  "replace": {
    "prestashop/blockreassurance": "^6",
    "prestashop/blockwishlist": "^4.0",
    "prestashop/classic": "~3.1.0",
    "prestashop/contactform": "^5",
    "prestashop/dashactivity": "^2",
    "prestashop/dashgoals": "^2",
    "prestashop/dashproducts": "^2",
    "prestashop/dashtrends": "^2",
    "prestashop/graphnvd3": "^2",
    "prestashop/gridhtml": "^2",
    "prestashop/gsitemap": "^5",
    "prestashop/hummingbird": "^2.1",
    "prestashop/pagesnotfound": "^4",
    "prestashop/productcomments": "^9.0",
    "prestashop/ps_apiresources": "^0.9.0",
    "prestashop/ps_banner": "^3",
    "prestashop/ps_bestsellers": "^2.0",
    "prestashop/ps_brandlist": "^1.0",
    "prestashop/ps_cashondelivery": "^3.0",
    "prestashop/ps_categoryproducts": "^2.0",
    "prestashop/ps_categorytree": "^3",
    "prestashop/ps_checkpayment": "^2",
    "prestashop/ps_contactinfo": "^3.3.3",
    "prestashop/ps_crossselling": "^2.0",
    "prestashop/ps_currencyselector": "^2",
    "prestashop/ps_customeraccountlinks": "^3",
    "prestashop/ps_customersignin": "^2",
    "prestashop/ps_customtext": "^4",
    "prestashop/ps_dataprivacy": "^2.0",
    "prestashop/ps_distributionapiclient": "^2.1",
    "prestashop/ps_emailalerts": "^3.0",
    "prestashop/ps_emailsubscription": "^3.0",
    "prestashop/ps_facetedsearch": "^5.1.0",
    "prestashop/ps_faviconnotificationbo": "^2",
    "prestashop/ps_featuredproducts": "^3",
    "prestashop/ps_googleanalytics": "^6",
    "prestashop/ps_imageslider": "^3",
    "prestashop/ps_languageselector": "^2",
    "prestashop/ps_linklist": "^7",
    "prestashop/ps_mainmenu": "^2",
    "prestashop/ps_newproducts": "^2",
    "prestashop/ps_onepagecheckout": "0.6.7",
    "prestashop/ps_searchbar": "^2",
    "prestashop/ps_sharebuttons": "^2",
    "prestashop/ps_shoppingcart": "^3",
    "prestashop/ps_socialfollow": "^2",
    "prestashop/ps_specials": "^2.0",
    "prestashop/ps_supplierlist": "^1.0",
    "prestashop/ps_themecusto": "^1",
    "prestashop/ps_viewedproduct": "^2",
    "prestashop/ps_wirepayment": "^3.0",
    "prestashop/psgdpr": "^1.4",
    "prestashop/statsbestcategories": "^2",
    "prestashop/statsbestcustomers": "^2",
    "prestashop/statsbestmanufacturers": "^2",
    "prestashop/statsbestproducts": "^3",
    "prestashop/statsbestsuppliers": "^2",
    "prestashop/statsbestvouchers": "^2",
    "prestashop/statscarrier": "^2",
    "prestashop/statscatalog": "^2",
    "prestashop/statscheckup": "^2",
    "prestashop/statsdata": "^2",
    "prestashop/statsforecast": "^2",
    "prestashop/statsnewsletter": "^2",
    "prestashop/statspersonalinfos": "^2",
    "prestashop/statsproduct": "^2",
    "prestashop/statsregistrations": "^2",
    "prestashop/statssales": "^2",
    "prestashop/statssearch": "^3",
    "prestashop/statsstock": "^2"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/PrestaShop/api-platform-core",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "https://github.com/PrestaShop/PHP-SQL-Parser",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "https://github.com/jolelievre/ps_apiresources",
      "no-api": true,
      "canonical": false
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "BTCPay\\": "modules/btcpay/src"
    },
    "classmap": [
      "modules/btcpay/btcpay.php"
    ]
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true
    },
    "platform": {
      "php": "8.4"
    },
    "preferred-install": "dist",
    "prepend-autoloader": false,
    "sort-packages": true
  },
  "scripts": {
    "post-install-cmd": [
      "@install-codestandards"
    ],
    "install-codestandards": [
      "Dealerdirect\\Composer\\Plugin\\Installers\\PHPCodeSniffer\\Plugin::run"
    ]
  }
}
