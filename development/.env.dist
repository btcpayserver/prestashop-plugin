# Ngrok configuration (only needed with `docker compose --profile tunnel up`)
NGROK_AUTHTOKEN=

# Shop version -> https://github.com/PrestaShop/prestashop-flashlight (tags: https://hub.docker.com/r/prestashop/prestashop-flashlight/tags)
PS_VERSION=8.2.7-alpine-nginx
#PS_VERSION=9.0.2-alpine-nginx
#PS_VERSION=8.0.5-8.1-fpm-alpine

# Local shop URL. Leave empty when using the tunnel profile (ngrok auto-detect).
# For local-only (no ngrok): PS_DOMAIN=localhost:8000 and comment NGROK_TUNNEL_AUTO_DETECT.
PS_DOMAIN=
NGROK_TUNNEL_AUTO_DETECT=http://ngrok:4040

# BTCPay bitcoin network
NBITCOIN_NETWORK=regtest
