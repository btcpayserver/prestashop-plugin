{
  "name": "btcpay/prestashop",
  "description": "BTCPay payment plugin for PrestaShop",
  "license": "MIT",
  "type": "prestashop-module",
  "keywords": [
    "prestashop",
    "plugin",
    "payment",
    "ecommerce",
    "bitcoin",
    "BTCPay"
  ],
  "homepage": "https://github.com/btcpayserver/prestashop-plugin",
  "support": {
    "issues": "https://github.com/btcpayserver/prestashop-plugin/issues",
    "source": "https://github.com/btcpayserver/prestashop-plugin"
  },
  "require": {
    "php": ">=8.4",
    "ext-bcmath": "*",
    "ext-ctype": "*",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-hash": "*",
    "ext-json": "*",
    "btcpayserver/btcpayserver-greenfield-php": "^2.8.1",
    "composer/semver": "^3.4.2",
    "stechstudio/backoff": "^1.4"
  },
  "require-dev": {
    "ergebnis/composer-normalize": "^2.43",
    "ext-dom": "*",
    "ext-filter": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "ext-simplexml": "*",
    "ext-tokenizer": "*",
    "ext-xmlwriter": "*",
    "phpunit/phpunit": "^12",
    "roave/security-advisories": "dev-latest",
    "symfony/debug-bundle": "^8.0",
    "symfony/var-dumper": "^8.0"
  },
  "minimum-stability": "stable",
  "autoload": {
    "psr-4": {
      "BTCPay\\": "src/"
    },
    "classmap": [
      "btcpay.php"
    ],
    "exclude-from-classmap": []
  },
  "autoload-dev": {
    "psr-4": {
      "BTCPay\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "ergebnis/composer-normalize": true,
      "php-http/discovery": true
    },
    "platform": {
      "php": "8.4"
    },
    "preferred-install": "dist",
    "prepend-autoloader": false,
    "sort-packages": true
  }
}
